						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if(pm.response.code === 201 && jsonData.id) {",
									"    pm.environment.set(\"BOOKING_ID\", jsonData.id);",
									"}"
								],
